# ─── Web UI Environment Variables ──────────────────
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# Database — PostgreSQL connection string
# For Neon: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# SMTP — Email server (for OTP password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="RhythmERP <your-email@gmail.com>"

# ─── API Keys (MUST be set in production) ──────────
# Shared secret for Next.js ↔ FastAPI proxy communication
# WARNING: If not set, proxy and callback endpoints have NO authentication
PROXY_API_KEY=your-proxy-api-key-here

# Default password for new users created by admin
# WARNING: Must be changed from the default in production
DEFAULT_USER_PASSWORD=changeme

# Default password for the seed admin user
# WARNING: Required — seeding will fail without it
SEED_ADMIN_PASSWORD=admin123
