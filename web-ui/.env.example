# ─── Web UI Environment Variables ──────────────────
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# Database — SQLite connection string
# IMPORTANT: The URL MUST start with "file:" protocol for Prisma SQLite.
# Path is relative to the prisma/ directory.
#
# Option 1: If your database is at prisma/db/custom.db
DATABASE_URL="file:./db/custom.db"
#
# Option 2: If your database is at prisma/dev.db
# DATABASE_URL="file:./dev.db"
#
# After creating .env, run: npx prisma db push
