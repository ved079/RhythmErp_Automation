# ─── Web UI Environment Variables ──────────────────
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# Database — PostgreSQL connection string
# For Neon: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# SMTP — Email server (for OTP password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="RhythmERP <your-email@gmail.com>"

# API Keys — MUST be set in production (no defaults provided)
# Shared secret for Next.js ↔ FastAPI proxy communication
PROXY_API_KEY=your-proxy-api-key-here

# Default password for new users created by admin
DEFAULT_USER_PASSWORD=changeme

# Default password for the seed admin user (only used in development)
SEED_ADMIN_PASSWORD=admin123
