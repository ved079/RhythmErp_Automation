# ─── Web UI Environment Variables ──────────────────
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# Database — PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Shared secret for Next.js ↔ FastAPI proxy communication
# Generate with: openssl rand -hex 32
PROXY_API_KEY=your-proxy-api-key-here

# Default password for new users created by admin
DEFAULT_USER_PASSWORD=changeme

# Default password for the seed admin user (required — seeding fails without it)
SEED_ADMIN_PASSWORD=admin123
