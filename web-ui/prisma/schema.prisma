generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  tester
  viewer
  client
}

enum UserStatus {
  active
  inactive
}

enum BugPriority {
  low
  medium
  high
}

enum BugStatus {
  open
  in_progress
  fixed
  closed
  rejected
}

enum ReplyAuthorRole {
  user
  admin
}

enum NotificationType {
  status_change
  reply
  schedule
  run_complete
}

enum Frequency {
  one_time
  daily
  weekly
}

enum TestSelection {
  all
  priority
  selected
}

enum RunStatus {
  pending
  running
  completed
  failed
  stopped
}

enum EnvStatus {
  active
  inactive
}

enum BrowserType {
  chrome
  firefox
  edge
  safari
}

enum SettingType {
  text
  number
  boolean
  select
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  reset_password
  toggle
  failed_login
  password_change
}

enum ModuleStatus {
  active
  draft
  disabled
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  password     String
  role         UserRole   @default(tester)
  status       UserStatus @default(active)
  moduleAccess String     @default("[]")
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions        Session[]
  passwordResets  PasswordReset[]
  runHistory      RunHistory[]
  bugReports      BugReport[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BugReport {
  id              String      @id @default(cuid())
  testId          String
  testDescription String
  moduleName      String
  error           String
  userNote        String
  priority        BugPriority @default(medium)
  status          BugStatus   @default(open)
  reporterName    String
  reporterEmail   String
  assignedTo      String?
  assignedToName  String?
  readByUser      Boolean     @default(true)
  readByAdmin     Boolean     @default(false)
  userId          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  replies Reply[]
}

model Reply {
  id           String         @id @default(cuid())
  bugReportId  String
  authorName   String
  authorRole   ReplyAuthorRole
  message      String
  createdAt    DateTime       @default(now())

  bugReport BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  ticketId  String?
  userId    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model ScheduledRun {
  id              String         @id @default(cuid())
  moduleId        String
  moduleName      String
  frequency       Frequency
  scheduledTime   DateTime
  testSelection   TestSelection  @default(all)
  selectedTestIds String?
  enabled         Boolean        @default(true)
  createdBy       String
  createdAt       DateTime       @default(now())
  lastRunAt       DateTime?
}

model RunHistory {
  id          String    @id @default(cuid())
  moduleId    String
  moduleName  String
  passed      Int
  failed      Int
  total       Int
  duration    String
  rate        Float
  results     String
  startedAt   DateTime
  completedAt DateTime?
  status      RunStatus @default(pending)
  createdBy   String?
  userId      String?

  user User? @relation(fields: [userId], references: [id])
}

// ─── Admin: Environment Management ──────────────────────

model Environment {
  id        String      @id @default(cuid())
  name      String      @unique
  baseUrl   String
  browser   BrowserType @default(chrome)
  status    EnvStatus   @default(active)
  color     String      @default("bg-green-500")
  lastUsed  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ─── Admin: System Settings ─────────────────────────────

model SystemSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  label       String
  value       String
  type        SettingType @default(text)
  description String      @default("")
  category    String      @default("general")
  options     String      @default("[]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── Admin: Test Module Management ────────────────────

model TestModule {
  id          String       @id @default(cuid())
  name        String       @unique
  label       String
  folderName  String?      // e.g. "entity_group" — the pages/ directory name
  parentId    String?
  parentLabel String?
  description String       @default("")
  sortOrder   Int          @default(0)
  testCount   Int          @default(0)
  status      ModuleStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─── Test Visibility (admin overrides + per-user hiding) ──

model TestOverride {
  id          String   @id @default(cuid())
  testName    String   @unique
  displayName String?
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestUserExclusion {
  id        String   @id @default(cuid())
  testName  String
  userId    String
  createdAt DateTime @default(now())

  @@unique([testName, userId])
}

// ─── Admin: Audit Log ──────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  userName    String
  action      AuditAction
  targetType  String
  targetId    String      @default("")
  targetLabel String      @default("")
  details     String      @default("")
  ipAddress   String      @default("")
  createdAt   DateTime    @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  userId    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
