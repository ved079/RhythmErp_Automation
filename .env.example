# ============================================
# RhythmERP Automation - Environment Configuration
# ============================================
# Copy this file and rename it to ".env"
# Then replace all <placeholders> with actual values
#
# For credentials, contact:
#   - Vedant Deokar
#   - Bhagyesh Patil
# ============================================

# --- Application URL ---
RHYTHMERP_BASE_URL=https://rhythmerp.algorhythms.in

# --- Login Credentials (for automation tests) ---
RHYTHMERP_EMAIL=<your_email>
RHYTHMERP_PASSWORD=<your_password>
RHYTHMERP_FACILITY=<facility_code_or_blank>

# --- Forgot Password Credentials (for Forgot Password tests) ---
RHYTHMERP_FP_EMAIL=<test_email>
RHYTHMERP_FP_USERNAME=<test_username>
RHYTHMERP_FP_TENANT=<tenant_name_or_blank>
RHYTHMERP_FP_CURRENT_PASSWORD=<current_password>
RHYTHMERP_FP_NEW_PASSWORD=<new_password>
RHYTHMERP_FP_ALT_PASSWORD=<alternate_password>
RHYTHMERP_FP_DEFAULT_PASSWORD=<default_password_to_reset_to>
RHYTHMERP_FP_OLD_PASSWORD_1=<old_password_1>
RHYTHMERP_FP_OLD_PASSWORD_2=<old_password_2>
RHYTHMERP_FP_OLD_PASSWORD_3=<old_password_3>

# --- Browser ---
BROWSER=chrome
HEADLESS=false

# --- Timeouts (in seconds) ---
EXPLICIT_WAIT=15
PAGE_LOAD_TIMEOUT=60

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Session ---
SESSION_EXPIRY_HOURS=24
