# ============================================
# RhythmERP Automation - Environment Configuration
# ============================================
# Copy this file and rename it to ".env"
# Then replace all <placeholders> with actual values
# ============================================

# --- ERP Instance URL ---
# Change to your local ERP server when running against a dev instance
RHYTHMERP_BASE_URL=http://localhost:8001

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
