        {
          "name": "Create Item Attribute1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('base_url');",
                  "const token   = pm.environment.get('token');",
                  "const tenantId = pm.environment.get('tenant_id');",
                  "const reqBody = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/core/dynamic-screen-wrapper/UOM/?page_number=1&page_size=100&search_string=&is_excel_download=false',",
                  "    method: 'GET',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + token,",
                  "        'X-Tenant-ID': tenantId,",
                  "        'Content-Type': 'application/json'",
                  "    }",
                  "}, function(err, res) {",
                  "    if (err) { console.error('UOM resolve error:', err); return; }",
                  "    const data = res.json();",
                  "    const results = data.screenmatlistingdata_set || data.results || data.data || [];",
                  "    const ids = results.map(function(r) { return r.id; }).filter(function(id) { return id != null; });",
                  "    if (ids[0] != null) reqBody.base_uom = ids[0];",
                  "    pm.request.body.raw = JSON.stringify(reqBody, null, 2);",
                  "});"
                ]
              }
            }
          ],
