                  "value": ""
                },
                {
                  "key": "is_excel_download",
                  "value": "false"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get UOM Conversion Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/core/dynamic-screen-wrapper/UOM%20Conversion/{{uom_conversion_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "core",
                "dynamic-screen-wrapper",
                "UOM%20Conversion",
                "{{uom_conversion_id}}",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create UOM Conversion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/core/dynamic-screen-wrapper/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "core",
                "dynamic-screen-wrapper",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"\",\n  \"attribute_name\": \"UOM Conversion\",\n  \"source_uom_code\": \"{{source_uom_id}}\",\n  \"target_uom_code\": \"{{target_uom_id}}\",\n  \"conversion_factor\": 1000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Pre-request script resolves source_uom_code and target_uom_code live from the UOM screen — same flow as the batch script FkResolver. No manual ID lookup needed."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('base_url');",
                  "const token = pm.environment.get('token');",
                  "const tenantId = pm.environment.get('tenant_id');",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/core/dynamic-screen-wrapper/UOM/?page_number=1&page_size=100&search_string=&is_excel_download=false',",
                  "    method: 'GET',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + token,",
                  "        'X-Tenant-ID': tenantId,",
                  "        'Content-Type': 'application/json',",
                  "    }",
                  "}, function(err, res) {",
                  "    if (err) { console.error(err); return; }",
                  "    const body = res.json();",
                  "    const results = body.results || body.data || [];",
                  "    const ids = results.map(r => r.id).filter(id => id !== undefined && id !== null);",
                  "    if (ids[0] !== undefined) pm.environment.set('source_uom_id', ids[0]);",
                  "    if (ids[1] !== undefined) pm.environment.set('target_uom_id', ids[1]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
