                "{{base_url}}"
              ],
              "path": [
                "core",
                "dynamic-screen-wrapper",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"\",\n  \"attribute_name\": \"UOM\",\n  \"uom_code\": \"GM\",\n  \"uom_description\": \"Gram\",\n  \"status\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
