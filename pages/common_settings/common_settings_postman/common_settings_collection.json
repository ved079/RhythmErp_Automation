            "description": "Pre-request script resolves tax_type_ref_id and country_ref_id live from ERP. No manual lookup needed."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('base_url');",
                  "const token = pm.environment.get('token');",
                  "const tenantId = pm.environment.get('tenant_id');",
                  "",
                  "function resolveScreen(screenName, cb) {",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/core/dynamic-screen-wrapper/' + screenName + '/?page_number=1&page_size=100&search_string=&is_excel_download=false',",
                  "        method: 'GET',",
                  "        header: {",
                  "            'Authorization': 'Bearer ' + token,",
                  "            'X-Tenant-ID': tenantId,",
                  "            'Content-Type': 'application/json',",
                  "        }",
                  "    }, function(err, res) {",
                  "        if (err) { console.error(err); cb([]); return; }",
                  "        const body = res.json();",
                  "        const results = body.results || body.data || [];",
                  "        const ids = results.map(r => r.id).filter(id => id !== undefined && id !== null);",
                  "        cb(ids);",
                  "    });",
                  "}",
                  "",
                  "resolveScreen('Tax%20Type', function(ids) {",
                  "    if (ids[0] !== undefined) pm.environment.set('tax_type_id', ids[0]);",
                  "});",
                  "resolveScreen('Country', function(ids) {",
                  "    if (ids[0] !== undefined) pm.environment.set('country_id', ids[0]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
