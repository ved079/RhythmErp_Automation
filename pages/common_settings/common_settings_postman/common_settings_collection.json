{
  "info": {
    "name": "Common Settings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rhythm ERP Common Settings module.\n\nSetup: import + set base_url, token, tenant_id in \"Rhythm ERP Environment\".\n\nFK ID note: Some modules have tenant-specific FK IDs that must be resolved by calling the respective List endpoints first. Those fields use {{env_var}} placeholders — set them in your environment before running Create requests."
  },
  "item": [
    {
      "name": "UOM",
      "description": "UOM CRUD — flat form, no steppers.\n\nuom_code must be unique, max 10 chars.",
      "item": [
        {
          "name": "List UOM",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/core/dynamic-screen-wrapper/UOM/?page_number=1&page_size=25&search_string=&is_excel_download=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "core",
                "dynamic-screen-wrapper",
                "UOM",
                ""
              ],
              "query": [
                {
                  "key": "page_number",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "25"
                },
                {
                  "key": "search_string",
                  "value": ""
                },
                {
                  "key": "is_excel_download",
                  "value": "false"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get UOM Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/core/dynamic-screen-wrapper/UOM/{{uom_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "core",
                "dynamic-screen-wrapper",
                "UOM",
                "{{uom_id}}",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create UOM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/core/dynamic-screen-wrapper/",
