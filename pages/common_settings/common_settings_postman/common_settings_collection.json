              "mode": "raw",
              "raw": "{\n  \"id\": \"\",\n  \"tax_name\": \"CGST Authority Mumbai\",\n  \"tax_type_ref_id\": \"{{tax_type_id}}\",\n  \"country_ref_id\": \"{{country_id}}\",\n  \"attribute_name\": \"Tax Authority\"\n}",
              "options": {
