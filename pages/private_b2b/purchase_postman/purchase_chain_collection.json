ount\": \"0.000\",\n      \"txn_currency_total_txn_amount\": \"0.000\",\n      \"uom\": 4,\n      \"round_of_credit_amount\": 0,\n      \"round_of_debit_amount\": 0\n    }\n  ],\n  \"grn_details\": [],\n  \"other_charges\": {\n    \"agent_ref_id\": null,\n    \"is_rate_percentage\": false,\n    \"agent_commision\": null,\n    \"agent_commision_amount\": 0\n  }\n}",
