                  "var altNetQty = parseFloat(pm.environment.get('pur_qc_alternate_accepted_qty'));",
                  "var discountPct = parseFloat(pm.environment.get('pur_qc_discount_rate') || '0');",
                  "var cdDeductionStr = pm.environment.get('pur_qc_c_d_deduction');",
                  "var cdDeduction = cdDeductionStr ? parseFloat(cdDeductionStr) : 0;",
                  "var txnCurrencyAmount = parseFloat(pm.environment.get('pur_qc_txn_currency_amount'));",
                  "var taxRate = parseFloat(pm.environment.get('pur_tax_rate') || '0');",
                  "",
                  "// PB-specific random inputs",
                  "var labourCharges = Math.round((Math.random() * (300 - 10) + 10) * 100) / 100;",
                  "var transportCharges = Math.round(Math.random() * 500 * 100) / 100;",
                  "var roundOffCredit = Math.round(Math.random() * 1000) / 1000;",
                  "var roundOffDebit = Math.round(Math.random() * 1000) / 1000;",
                  "",
                  "// PB line math (mirrors _pb_items_from_qc in purchase_chain.py)",
                  "function round6(v) { return Math.round(v * 1000000) / 1000000; }",
                  "function fmt3(v) { return parseFloat(v).toFixed(3); }",
                  "",
                  "var amountDetail = round6(txnCurrencyAmount - labourCharges);",
                  "var isGstSetOff = taxRate > 0;",
                  "var gstType = isGstSetOff ? 'IGST' : null;",
                  "var igstAmount = isGstSetOff ? round6(amountDetail * taxRate / 100) : 0;",
                  "var taxAmount = igstAmount;",
                  "var discount = cdDeduction || 0;",
                  "var totalTxn = round6(amountDetail - discount + taxAmount - labourCharges);",
                  "",
                  "// Header aggregates",
                  "var txnCurrencyAmountHdr = amountDetail;",
                  "var txnCurrencyDiscountHdr = discount;",
                  "var txnCurrencyTotalHdr = totalTxn;",
                  "var totalQuantity = Math.round(altNetQty * 1000) / 1000;",
                  "",
                  "var reqBody = JSON.parse(pm.request.body.raw);",
                  "reqBody.transaction_date = today;",
                  "reqBody.supplier_ref_id = parseInt(pm.environment.get('pur_supplier_id'));",
                  "reqBody.qc_ref_id_id = parseInt(pm.environment.get('pur_qc_id'));",
                  "reqBody.grn_ref_id_id = parseInt(pm.environment.get('pur_grn_id'));",
                  "reqBody.po_ref_id_id = parseInt(pm.environment.get('pur_po_id'));",
