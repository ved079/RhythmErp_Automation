                  "item.txn_currency_igst_amount = fmt3(igstAmount);",
                  "item.txn_currency_cgst_rate = null;",
                  "item.txn_currency_cgst_amount = '0.000';",
                  "item.txn_currency_sgst_rate = null;",
                  "item.txn_currency_sgst_amount = '0.000';",
                  "item.txn_currency_tax_amount = fmt3(taxAmount);",
