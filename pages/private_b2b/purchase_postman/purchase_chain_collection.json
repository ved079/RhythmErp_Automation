                  "reqBody.txn_currency_total_amount = fmt3(txnCurrencyTotalHdr);",
                  "reqBody.txn_currency_discount_amount = fmt3(txnCurrencyDiscountHdr);",
                  "",
                  "var item = reqBody.purchase_booking_details[0];",
                  "item.item_ref_id = parseInt(pm.environment.get('pur_item_ref_id'));",
