                  "",
                  "// Read QC line values saved during Create QC pre-request",
                  "var baseRate = parseFloat(pm.environment.get('pur_qc_base_rate'));",
                  "var altQty = parseFloat(pm.environment.get('pur_qc_grn_qty'));",
