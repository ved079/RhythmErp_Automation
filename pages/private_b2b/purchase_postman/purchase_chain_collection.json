        {
          "name": "Create Quality Check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_date\": \"2026-08-24\",\n  \"supplier_ref_id\": 1,\n  \"supplier_ref_type\": \"Supplier\",\n  \"item_type_ref_id\": 113,\n  \"gate_pass_ref_id_id\": null,\n  \"grn_ref_id_id\": null,\n  \"po_ref_id_id\": null,\n  \"base_currency\": 1,\n  \"txn_currency\": 1,\n  \"conversion_rate\": 1.0,\n  \"parameter1\": 1,\n  \"parameter2\": 1,\n  \"parameter5\": 1,\n  \"parameter6\": 1,\n  \"vehicle_no\": null,\n  \"driver_name\": null,\n  \"total_txn_currency_amount\": 0,\n  \"qc_additional_details\": { \"remark\": null },\n  \"qc_details\": [\n    {\n      \"item_ref_id\": 5,\n      \"hsn_sac_no\": 2,\n      \"alternate_uom\": 3,\n      \"uom\": 4,\n      \"uom_conversion\": 1.0,\n      \"is_rate_weight_deduction\": false,\n      \"base_rate\": 2000,\n      \"grn_qty\": 1000,\n      \"no_of_bags\": 1000,\n      \"alternate_rejected_qty\": 0,\n      \"total_amount\": 2000000,\n      \"empty_bag_weight\": 5.0,\n      \"empty_bags_txn_amount\": 10000,\n      \"alternate_accepted_qty\": 995,\n      \"deduction_percent\": 2.5,\n      \"qc_deduction_rate\": 50,\n      \"deduction_weight\": 25,\n      \"qc_deduction_amount\": 497500,\n      \"discount_rate\": 1.0,\n      \"c_d_deduction\": 14925,\n      \"txn_currency_amount\": 1477575,\n      \"rate\": 1485.5,\n      \"qc_parameter_details\": [\n        {\n          \"item_quality_parameter_ref_id\": 1,\n          \"actual_value\": 1,\n          \"allowable_percent\": 0.0,\n          \"quantity_deduction\": 25\n        }\n      ],\n      \"qc_bags_details\": [\n        {\n          \"type_of_bags_ref_id\": 1,\n          \"quantity_of_bags\": 1000,\n          \"weight_of_bags\": 0.005,\n          \"total_weight_of_bags\": 5.0\n        }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/procure_to_pay/quality-control/",
              "host": ["{{base_url}}"],
              "path": ["procure_to_pay", "quality-control", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var today = new Date().toISOString().split('T')[0];",
                  "var baseRate = parseFloat(pm.environment.get('pur_rate'));",
                  "var grnQty = parseFloat(pm.environment.get('pur_qty'));",
                  "var bags = Math.max(1, Math.floor(grnQty));",
                  "",
                  "// Random QC inputs (matching purchase_chain.py ranges)",
                  "var emptyBagWeight = Math.round(Math.random() * 12 * 100) / 100;",
                  "var deductionPercent = Math.round(Math.random() * 5 * 100) / 100;",
                  "var discountRate = Math.round(Math.random() * 5 * 100) / 100;",
                  "",
                  "// QC math — mirrors _compute_qc_line_fields in purchase_chain.py",
                  "function round6(v) { return Math.round(v * 1000000) / 1000000; }",
                  "var totalAmount = round6(baseRate * grnQty);",
                  "var emptyBagsTxnAmount = round6(emptyBagWeight * baseRate);",
                  "var acceptedQty = grnQty - emptyBagWeight;",
                  "var qcDeductionRate = round6(baseRate * deductionPercent / 100);",
                  "var deductionWeight = round6(grnQty * deductionPercent / 100);",
                  "var netOfEmptyBag = totalAmount - emptyBagsTxnAmount;",
                  "var qcDeductionAmount = round6(netOfEmptyBag * deductionPercent / 100);",
                  "var subtotal = totalAmount - emptyBagsTxnAmount - qcDeductionAmount;",
                  "var cdDeduction = discountRate ? round6(subtotal * discountRate / 100) : null;",
                  "var txnCurrencyAmount = round6(subtotal - (cdDeduction || 0));",
                  "var netRate = acceptedQty ? round6(txnCurrencyAmount / acceptedQty) : 0;",
                  "var quantityDeduction = Math.ceil(deductionWeight);",
                  "",
                  "// Save QC line values for PB pre-request",
                  "pm.environment.set('pur_qc_base_rate', baseRate);",
                  "pm.environment.set('pur_qc_grn_qty', grnQty);",
                  "pm.environment.set('pur_qc_no_of_bags', bags);",
                  "pm.environment.set('pur_qc_empty_bag_weight', emptyBagWeight);",
                  "pm.environment.set('pur_qc_empty_bags_txn_amount', emptyBagsTxnAmount);",
                  "pm.environment.set('pur_qc_alternate_accepted_qty', acceptedQty);",
                  "pm.environment.set('pur_qc_deduction_percent', deductionPercent);",
                  "pm.environment.set('pur_qc_deduction_rate', qcDeductionRate);",
                  "pm.environment.set('pur_qc_deduction_weight', deductionWeight);",
                  "pm.environment.set('pur_qc_deduction_amount', qcDeductionAmount);",
                  "pm.environment.set('pur_qc_discount_rate', discountRate);",
                  "pm.environment.set('pur_qc_c_d_deduction', cdDeduction !== null ? cdDeduction : '');",
                  "pm.environment.set('pur_qc_txn_currency_amount', txnCurrencyAmount);",
                  "pm.environment.set('pur_qc_net_rate', netRate);",
                  "pm.environment.set('pur_qc_quantity_deduction', quantityDeduction);",
                  "",
                  "var reqBody = JSON.parse(pm.request.body.raw);",
                  "reqBody.transaction_date = today;",
                  "reqBody.supplier_ref_id = parseInt(pm.environment.get('pur_supplier_id'));",
                  "reqBody.item_type_ref_id = parseInt(pm.environment.get('pur_po_item_type'));",
                  "reqBody.gate_pass_ref_id_id = parseInt(pm.environment.get('pur_gp_id'));",
                  "reqBody.grn_ref_id_id = parseInt(pm.environment.get('pur_grn_id'));",
                  "reqBody.po_ref_id_id = parseInt(pm.environment.get('pur_po_id'));",
                  "reqBody.base_currency = parseInt(pm.environment.get('pur_base_currency'));",
                  "reqBody.txn_currency = parseInt(pm.environment.get('pur_txn_currency'));",
                  "reqBody.parameter1 = parseInt(pm.environment.get('pur_parameter1'));",
                  "reqBody.parameter2 = parseInt(pm.environment.get('pur_parameter2'));",
                  "reqBody.parameter5 = parseInt(pm.environment.get('pur_parameter5'));",
                  "reqBody.parameter6 = parseInt(pm.environment.get('pur_parameter6'));",
                  "reqBody.total_txn_currency_amount = txnCurrencyAmount;",
                  "var item = reqBody.qc_details[0];",
                  "item.item_ref_id = parseInt(pm.environment.get('pur_item_ref_id'));",
                  "item.hsn_sac_no = parseInt(pm.environment.get('pur_hsn_sac_no'));",
                  "item.alternate_uom = parseInt(pm.environment.get('pur_alternate_uom'));",
                  "item.uom = parseInt(pm.environment.get('pur_uom'));",
                  "item.uom_conversion = parseFloat(pm.environment.get('pur_uom_conversion') || '1');",
                  "item.base_rate = baseRate;",
                  "item.grn_qty = grnQty;",
                  "item.no_of_bags = bags;",
                  "item.alternate_rejected_qty = 0;",
                  "item.total_amount = totalAmount;",
                  "item.empty_bag_weight = emptyBagWeight;",
                  "item.empty_bags_txn_amount = emptyBagsTxnAmount;",
                  "item.alternate_accepted_qty = acceptedQty;",
                  "item.deduction_percent = deductionPercent;",
                  "item.qc_deduction_rate = qcDeductionRate;",
                  "item.deduction_weight = deductionWeight;",
                  "item.qc_deduction_amount = qcDeductionAmount;",
                  "item.discount_rate = discountRate;",
                  "item.c_d_deduction = cdDeduction;",
                  "item.txn_currency_amount = txnCurrencyAmount;",
                  "item.rate = netRate;",
                  "// NOTE: qc_parameter_details[0].item_quality_parameter_ref_id=1 assumes",
                  "// Moisture is param ID 1 — update if your ERP uses different IDs.",
                  "// Resolve from Commodity Quality Parameter screen if needed.",
                  "item.qc_parameter_details[0].quantity_deduction = quantityDeduction;",
                  "// NOTE: qc_bags_details[0].type_of_bags_ref_id=1 is the fallback bag type.",
                  "// Check your ERP's Packages screen and update if ID 1 does not exist.",
                  "item.qc_bags_details[0].quantity_of_bags = bags;",
                  "item.qc_bags_details[0].weight_of_bags = bags > 0 ? Math.round(emptyBagWeight / bags * 10000) / 10000 : 1;",
                  "item.qc_bags_details[0].total_weight_of_bags = emptyBagWeight;",
                  "pm.request.body.raw = JSON.stringify(reqBody, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "var id = data.id || data.entry_id;",
                  "if (id) { pm.environment.set('pur_qc_id', id); console.log('QC created: #' + id); }",
                  "else { console.log('QC creation failed:', JSON.stringify(data)); }"
                ]
              }
            }
          ]
        }
      ]
    },
