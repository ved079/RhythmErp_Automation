{
  "info": {
    "name": "Purchase Chain",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "PO",
      "item": [
        {
          "name": "List Purchase Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/procure_to_pay/purchase_order/?page_number=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["procure_to_pay", "purchase_order", ""],
              "query": [
                { "key": "page_number", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clear stale purchase sniff vars",
                  "['pur_supplier_id','pur_ship_from','pur_bill_from','pur_po_item_type',",
                  " 'pur_po_type','pur_base_currency','pur_txn_currency',",
                  " 'pur_parameter1','pur_parameter2','pur_parameter5','pur_parameter6',",
                  " 'pur_supplier_payment_terms','pur_supplier_delivery_terms',",
                  " 'pur_item_ref_id','pur_hsn_sac_no','pur_uom','pur_alternate_uom',",
                  " 'pur_uom_conversion','pur_tax_rate'].forEach(function(v){ pm.environment.unset(v); });",
                  "",
                  "var body = pm.response.json();",
                  "// PO listing returns 'rows' key (procure_to_pay pattern)",
                  "var rows = body.rows || body.screenmatlistingdata_set || [];",
                  "if (!rows.length) { console.log('No POs found — run Create PO first'); return; }",
                  "",
                  "var firstId = rows[0].id;",
                  "var baseUrl = pm.environment.get('base_url');",
                  "var token = pm.environment.get('token');",
                  "var tenantId = pm.environment.get('tenant_id');",
                  "",
                  "// Fetch PO detail to sniff all header defaults + supplier FKs + item data",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/procure_to_pay/purchase_order/' + firstId + '/',",
                  "    method: 'GET',",
                  "    header: { 'Authorization': 'Bearer ' + token, 'X-Tenant-ID': tenantId }",
                  "}, function(err, res) {",
                  "    if (err || res.code !== 200) { console.log('PO detail fetch failed'); return; }",
                  "    var d = res.json();",
                  "    pm.environment.set('pur_supplier_id', d.supplier_ref_id);",
                  "    pm.environment.set('pur_po_item_type', d.po_item_type);",
                  "    pm.environment.set('pur_po_type', d.po_type);",
                  "    pm.environment.set('pur_base_currency', d.base_currency);",
                  "    pm.environment.set('pur_txn_currency', d.txn_currency);",
                  "    pm.environment.set('pur_parameter1', d.parameter1);",
                  "    pm.environment.set('pur_parameter2', d.parameter2);",
                  "    pm.environment.set('pur_parameter5', d.parameter5);",
                  "    pm.environment.set('pur_parameter6', d.parameter6);",
                  "    pm.environment.set('pur_supplier_payment_terms', d.supplier_payment_terms);",
                  "    pm.environment.set('pur_supplier_delivery_terms', d.supplier_delivery_terms);",
                  "    var sd = d.supplier_details || {};",
                  "    pm.environment.set('pur_ship_from', sd.supplier_ship_from);",
                  "    pm.environment.set('pur_bill_from', sd.supplier_bill_from);",
                  "    var items = d.purchasing_order_items_details || [];",
                  "    if (items.length) {",
                  "        var it = items[0];",
                  "        pm.environment.set('pur_item_ref_id', it.item_ref_id);",
                  "        pm.environment.set('pur_hsn_sac_no', it.hsn_sac_no);",
                  "        pm.environment.set('pur_uom', it.uom);",
                  "        pm.environment.set('pur_alternate_uom', it.alternate_uom);",
                  "        pm.environment.set('pur_uom_conversion', it.uom_conversion || 1.0);",
                  "        pm.environment.set('pur_tax_rate', it.tax_rate || 0);",
                  "    }",
                  "    console.log('PO defaults sniffed from PO #' + firstId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get PO Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/procure_to_pay/purchase_order/{{pur_po_id}}/",
              "host": ["{{base_url}}"],
              "path": ["procure_to_pay", "purchase_order", "{{pur_po_id}}", ""]
            }
          },
          "response": []
        },
        {
          "name": "Create Purchase Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Tenant-ID", "value": "{{tenant_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_date\": \"2026-08-24\",\n  \"supplier_ref_id\": 1,\n  \"supplier_ref_type\": \"Supplier\",\n  \"po_item_type\": 113,\n  \"po_type\": 25,\n  \"base_currency\": 1,\n  \"txn_currency\": 1,\n  \"conversion_rate\": 1.0,\n  \"parameter1\": 1,\n  \"parameter2\": 1,\n  \"parameter3\": 25,\n  \"parameter4\": 1,\n  \"parameter5\": 1,\n  \"parameter6\": 1,\n  \"item_category\": 113,\n  \"supplier_payment_terms\": null,\n  \"supplier_delivery_terms\": null,\n  \"tax_registration_status\": \"Registered\",\n  \"supplier_details\": {\n    \"supplier_ship_from\": null,\n    \"supplier_bill_from\": null\n  },\n  \"additional_details\": {\n    \"transportation_charges\": 0,\n    \"txn_currency_discount_percent\": null,\n    \"txn_currency_discount_amount\": 0,\n    \"txn_currency_interest_percent\": null,\n    \"txn_currency_interest_amount\": 0,\n    \"remark\": null\n  },\n  \"purchasing_order_items_details\": [\n    {\n      \"item_ref_id\": 5,\n      \"hsn_sac_no\": 2,\n      \"uom\": 4,\n      \"alternate_uom\": 3,\n      \"uom_conversion\": 1.0,\n      \"alternate_quantity\": \"1000\",\n      \"rate\": 2000,\n      \"gst_type\": \"IGST\",\n      \"tax_rate\": 5,\n      \"txn_currency_amount_detail\": 2000000,\n      \"txn_currency_tax_amount_details\": 100000,\n      \"total_amount\": 2100000,\n      \"expected_delivery_date\": \"2026-08-24\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/procure_to_pay/purchase_order/",
              "host": ["{{base_url}}"],
              "path": ["procure_to_pay", "purchase_order", ""]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate random qty/rate (carried through all chain steps)",
                  "var qty = Math.floor(Math.random() * (2000 - 500 + 1)) + 500;",
                  "var rate = Math.round((Math.random() * (6000 - 500) + 500) * 100) / 100;",
                  "var taxRate = parseFloat(pm.environment.get('pur_tax_rate') || '0');",
                  "var today = new Date().toISOString().split('T')[0];",
                  "",
                  "function round6(v) { return Math.round(v * 1000000) / 1000000; }",
                  "var amount = round6(rate * qty);",
                  "var taxAmount = round6(amount * taxRate / 100);",
                  "var totalAmount = round6(amount + taxAmount);",
                  "",
                  "// Save for subsequent GP/GRN/QC/PB steps",
                  "pm.environment.set('pur_qty', qty);",
                  "pm.environment.set('pur_rate', rate);",
                  "pm.environment.set('pur_no_of_bags', Math.max(1, Math.floor(qty)));",
                  "",
                  "var reqBody = JSON.parse(pm.request.body.raw);",
                  "reqBody.transaction_date = today;",
                  "reqBody.supplier_ref_id = parseInt(pm.environment.get('pur_supplier_id'));",
                  "reqBody.po_item_type = parseInt(pm.environment.get('pur_po_item_type'));",
                  "reqBody.item_category = parseInt(pm.environment.get('pur_po_item_type'));",
                  "reqBody.po_type = parseInt(pm.environment.get('pur_po_type'));",
                  "reqBody.base_currency = parseInt(pm.environment.get('pur_base_currency'));",
                  "reqBody.txn_currency = parseInt(pm.environment.get('pur_txn_currency'));",
                  "reqBody.parameter1 = parseInt(pm.environment.get('pur_parameter1'));",
                  "reqBody.parameter2 = parseInt(pm.environment.get('pur_parameter2'));",
                  "reqBody.parameter5 = parseInt(pm.environment.get('pur_parameter5'));",
                  "reqBody.parameter6 = parseInt(pm.environment.get('pur_parameter6'));",
                  "var pt = pm.environment.get('pur_supplier_payment_terms');",
                  "reqBody.supplier_payment_terms = pt ? parseInt(pt) : null;",
                  "var dt = pm.environment.get('pur_supplier_delivery_terms');",
                  "reqBody.supplier_delivery_terms = dt ? parseInt(dt) : null;",
                  "reqBody.supplier_details = {",
                  "    supplier_ship_from: parseInt(pm.environment.get('pur_ship_from')),",
                  "    supplier_bill_from: parseInt(pm.environment.get('pur_bill_from'))",
                  "};",
                  "var item = reqBody.purchasing_order_items_details[0];",
                  "item.item_ref_id = parseInt(pm.environment.get('pur_item_ref_id'));",
                  "item.hsn_sac_no = parseInt(pm.environment.get('pur_hsn_sac_no'));",
                  "item.uom = parseInt(pm.environment.get('pur_uom'));",
                  "item.alternate_uom = parseInt(pm.environment.get('pur_alternate_uom'));",
                  "item.uom_conversion = parseFloat(pm.environment.get('pur_uom_conversion') || '1');",
                  "item.alternate_quantity = String(qty);",
                  "item.rate = rate;",
                  "item.tax_rate = taxRate;",
                  "item.txn_currency_amount_detail = amount;",
                  "item.txn_currency_tax_amount_details = taxAmount;",
                  "item.total_amount = totalAmount;",
                  "item.expected_delivery_date = today;",
                  "pm.request.body.raw = JSON.stringify(reqBody, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "var id = data.id || data.entry_id;",
                  "if (id) { pm.environment.set('pur_po_id', id); console.log('PO created: #' + id); }",
                  "else { console.log('PO creation failed:', JSON.stringify(data)); }"
                ]
              }
            }
          ]
        }
      ]
    },
