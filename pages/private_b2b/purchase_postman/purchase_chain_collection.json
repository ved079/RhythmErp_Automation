                  "item.no_of_bags = noOfBags;",
                  "item.empty_bag_weight = emptyBagWeight;",
                  "item.empty_bags_txn_amount = fmt3(emptyBagsTxnAmount);",
                  "item.alternate_net_qty = altNetQty;",
                  "item.discount_percentage = discountPct;",
                  "item.txn_currency_discount_amount_details = fmt3(discount);",
                  "item.txn_currency_amount_detail = fmt3(amountDetail);",
                  "item.labour_charges = labourCharges;",
                  "item.is_gst_set_off = isGstSetOff;",
                  "item.tax_rate = taxRate;",
                  "item.gst_type = gstType;",
